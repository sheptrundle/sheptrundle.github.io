---
const links = [
  { href: '#about', label: 'About' },
  { href: '#projects', label: 'Projects' },
  { href: '#experience', label: 'Experience' },
  { href: '#coursework', label: 'Coursework' },
  { href: '#contact', label: 'Contact' },
];
---
<header class="nav">
  <div class="container inner">
    <a href="#about" class="brand">Shep Trundle</a>
    <nav aria-label="Sections">
      <ul>{links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </nav>
  </div>
</header>

<style>
  .nav { position: sticky; top: 0; z-index: 10; background: var(--banner); border-bottom: 3px solid var(--orange); }
  .inner { display: flex; align-items: center; justify-content: space-between; height: 56px; gap: 16px; }
  .brand { font-weight: 600; color: #fff; white-space: nowrap; }
  .brand:hover { text-decoration: none; }
  ul { display: flex; gap: 24px; list-style: none; }
  nav a { color: var(--banner-muted); font-size: 14px; }
  nav a:hover { color: #fff; text-decoration: none; }
  @media (max-width: 600px) {
    .brand { font-size: 15px; }
    ul { gap: 12px; }
    nav a { font-size: 13px; }
  }
  /* Phones: the name and five links don't fit on one row, so the links get their own row
     under the name. Only applies below 520px; wider screens are unaffected. */
  @media (max-width: 520px) {
    .inner { height: auto; flex-direction: column; align-items: stretch; gap: 2px; padding-top: 10px; padding-bottom: 8px; }
    nav { width: 100%; }
    ul { justify-content: space-between; gap: 8px; }
    nav a { font-size: 13px; padding: 4px 0; }
  }
</style>
