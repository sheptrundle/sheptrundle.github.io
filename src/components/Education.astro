---
import { schools, organizations } from '../data/education';
---
<section class="section tone-navy" id="coursework">
  <div class="container">
    <h2 class="section-label">Coursework</h2>
    <div class="stack">
      {schools.map((s) => (
        <div class="block school reveal">
          <header class="block-head">
            <div>
              <h3>{s.name}</h3>
              {s.degree && <p class="sub">{s.degree}</p>}
              <p class="sub">{s.location}{s.detail && ` · ${s.detail}`}</p>
            </div>
            <p class="meta">{s.dates}</p>
          </header>
          <div class="courses">
            {s.courses.map((c) => (
              <article class="course">
                <p class="meta">{c.code}</p>
                <h4>{c.name}</h4>
                <p class="desc">{c.description}</p>
                {c.link && (
                  <p class="work"><a href={c.link.href} target="_blank" rel="noopener">{c.link.label ?? 'Coursework'} →</a></p>
                )}
              </article>
            ))}
          </div>
        </div>
      ))}
      <div>
        <h3 class="orgs-title">Organizations</h3>
        <p>{organizations.join(' · ')}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .stack { display: grid; gap: 24px; }
  h3 { font-size: 18px; }
  /* Courses tile inside the school block. Each tile draws its own right/bottom rule,
     so an empty slot in the last row stays plain white. */
  .courses {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1px; background: var(--surface);
  }
  .course {
    background: var(--surface); padding: 18px 20px; display: flex; flex-direction: column;
    box-shadow: 1px 0 0 var(--border), 0 1px 0 var(--border);
  }
  .course .meta { color: var(--link); }
  h4 { font-size: 16px; margin-top: 2px; }
  .desc { font-size: 15px; color: var(--muted); margin-top: 8px; }
  /* links sit at the bottom of each tile so they line up across a row */
  .work { font-size: 14px; font-weight: 500; margin-top: auto; padding-top: 12px; }
  .orgs-title { font-size: 16px; margin: 8px 0 6px; }
</style>
